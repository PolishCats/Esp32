              },
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"light_value\": 2500,\n  \"intervalo_recoleccion\": 5\n}"
            },
            "url": {
              "raw": "{{base_url}}/data",
              "host": ["{{base_url}}"],
              "path": ["data"]
            },
            "description": "Enviar una lectura LDR usando API Key o JWT."
          }
        },
        {
          "name": "LED State for Device",
          "request": {
            "method": "GET",
